{
  "name": "vora-backend",
  "version": "1.0.0",
  "description": "VORA Real-time Express Backend with Socket.io & NeonDB (PostgreSQL)",
  "main": "src/server.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --verbose",
    "test:unit": "jest --verbose --testPathPatterns='pricing|geofence|anonymize'",
    "test:integration": "jest --verbose --testPathPatterns='integration'"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.4",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
